{
  "name": "@myelophone/nuxt-template",
  "version": "0.10.0",
  "type": "module",
  "author": "Aliaksandr Ivanou <aleksivanov.me@gmail.com> (https://github.com/aleksivanou)",
  "maintainers": [
    {
      "name": "MyelophOne",
      "url": "https://github.com/MyelophOne"
    }
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "NUXT_TELEMETRY_DEBUG=1 PROD_DIST=true nuxt dev",
    "build": "NODE_OPTIONS='--no-deprecation' NODE_ENV=production NUXT_TELEMETRY_DEBUG=1 NODE_ENV=production PROD_DIST=true nuxt build",
    "generate": "NUXT_TELEMETRY_DEBUG=1 NODE_ENV=production PROD_DIST=true NUXT_STATIC=true nuxt generate",
    "preview": "NUXT_TELEMETRY_DEBUG=1 PROD_DIST=true nuxt preview",
    "profile": "NODE_OPTIONS='--no-deprecation' NUXT_TELEMETRY_DEBUG=1 NODE_ENV=production NUXT_PLAYGROUND=true NUXT_PROFILE=1 nuxt build",
    "server": "node --no-deprecation --no-warnings .output/server/index.mjs",
    "static": "npx serve .output/public",
    "sandbox:dev": "NUXT_TELEMETRY_DEBUG=1 NUXT_PLAYGROUND=true nuxt dev playground",
    "sandbox:build": "NODE_OPTIONS='--no-deprecation' NUXT_TELEMETRY_DEBUG=1 NUXT_PLAYGROUND=true nuxt build playground",
    "sandbox:preview": "NUXT_TELEMETRY_DEBUG=1 nuxt preview playground",
    "sandbox:profile": "NODE_OPTIONS='--no-deprecation' NUXT_TELEMETRY_DEBUG=1 NODE_ENV=production NUXT_PLAYGROUND=true NUXT_PROFILE=1 nuxt build playground",
    "sandbox:server": "node --no-deprecation --no-warnings playground/.output/server/index.mjs",
    "sandbox:static": "npx serve playground/.output/public",
    "postinstall": "nuxt prepare && nuxt prepare playground",
    "analyze": "NODE_OPTIONS='--no-deprecation' yarn nuxi analyze",
    "test": "yarn test:types && yarn playwright",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "playwright:install": "npx playwright install chromium",
    "playwright": "npx playwright test",
    "biome:check": "biome check --write ./app",
    "biome:format": "biome format --fix ./app",
    "biome:all": "biome format --fix .",
    "upgrade": "npx nuxi upgrade && yarn prepare",
    "update": "yarn upgrade-interactive",
    "clear": "yarn cache clean",
    "audit": "yarn npm audit",
    "self-update": "yarn set version berry",
    "lock-update": "yarn dedupe --strategy highest",
    "yarnview": "npm view @myelophone/nuxt versions"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@myelophone/nuxt": "^0.23.0",
    "@nuxt/fonts": "^1.2.1",
    "@nuxt/image": "^2.2.1",
    "@nuxt/schema": "^4.7.0",
    "@nuxt/scripts": "^1.3.14",
    "@nuxt/types": "^2.18.1",
    "@nuxtjs/robots": "^7.1.0",
    "@pinia/colada": "^1.4.9",
    "@pinia/colada-nuxt": "^1.2.1",
    "@pinia/nuxt": "^1.0.3",
    "@playwright/test": "^1.65.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@unhead/vue": "^3.5.3",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.1.0",
    "commitlint": "^21.2.4",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "jiti": "^2.7.0",
    "markdown-it": "^15.0.3",
    "nuxt": "^4.7.0",
    "nuxt-api-party": "^5.0.3",
    "nuxt-link-checker": "^6.0.3",
    "nuxt-og-image": "^7.2.1",
    "nuxt-payload-analyzer": "^0.1.4",
    "nuxt-security": "^2.7.0",
    "nuxt-seo-utils": "^9.1.1",
    "nuxt-umami": "^3.2.1",
    "nuxt-vitalizer": "^4.0.0",
    "pinia": "^4.1.0",
    "postcss": "^8.5.33",
    "postcss-no-important": "^11.0.0",
    "purgecss": "^9.1.0",
    "rolldown": "^1.3.4",
    "semantic-release": "^26.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "unstorage": "^2.0.0-beta.0",
    "valibot": "^1.5.0",
    "vite": "^8.4.0",
    "vue": "^3.5.46",
    "vue-easy-lightbox": "^1.19.0",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.14",
    "yaml": "^2.9.1"
  },
  "packageManager": "yarn@4.19.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/myelophone/nuxt-template.git"
  }
}
